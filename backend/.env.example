# Copia este archivo como ".env" (sin .example) y completa los valores.
# NUNCA subas el archivo .env a GitHub.

# Proveedor de IA: gemini  o  claude
IA_PROVIDER=gemini

# Si usas Gemini: clave creada en Google AI Studio
GEMINI_API_KEY=
# Los nombres de modelo cambian: copia uno vigente desde AI Studio si este deja de funcionar
GEMINI_MODEL=gemini-flash-latest

# Si usas Claude: clave creada en la consola de Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
